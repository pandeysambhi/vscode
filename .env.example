# Copy this file to .env at the repository root. Never commit .env.

# GitHub or GitHub Enterprise
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Jira Cloud: set email and API token. Jira Data Center bearer auth: leave email empty.
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Microsoft Graph
MS_GRAPH_TOKEN=
MS_GRAPH_URL=https://graph.microsoft.com/v1.0

# Keep false until MCP write operations are intentionally enabled.
ENTERPRISE_MCP_ALLOW_WRITES=false
